{
  "name": "@harrywan/dsh-digital-human",
  "version": "1.0.0",
  "description": "Configurable digital humans for DSH: persona, memory, peers, IM binding, schedule.",
  "license": "MIT",
  "author": "wanchun",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "digital-human",
    "agent",
    "agent-preset",
    "multi-agent",
    "im"
  ],
  "homepage": "https://github.com/wanchun/dsh-digital-human#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wanchun/dsh-digital-human.git"
  },
  "bugs": {
    "url": "https://github.com/wanchun/dsh-digital-human/issues"
  },
  "type": "module",
  "main": "./build/host/index.js",
  "types": "./build/host/index.d.ts",
  "exports": {
    ".": "./build/host/index.js",
    "./tools": "./build/host/tools.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "build/",
    "lib/",
    "locale/",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@vitest/coverage-v8": "^5.0.4",
    "jsdom": "^30.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "vite build && node tools/wrap-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "pnpm run build && pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:integration": "node test/smoke.mjs && node test/memory.mjs && node test/apply.mjs && node test/wiring.mjs && node test/schema.mjs && node test/im.mjs"
  }
}
